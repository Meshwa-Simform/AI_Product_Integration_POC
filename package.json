{
  "name": "ai-product-integration-poc",
  "version": "1.0.0",
  "description": "G3 POC: RAG-based Knowledge Base Q&A using OpenAI + Pinecone",
  "type": "module",
  "scripts": {
    "generate-mock-data": "tsx scripts/generateMockData.ts",
    "ingest": "tsx src/ingest.ts",
    "query": "tsx src/query.ts",
    "evaluate": "tsx scripts/evaluate.ts",
